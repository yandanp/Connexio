{
	"name": "connexio",
	"version": "0.5.0",
	"description": "Connexio — Project-based Terminal Manager. Organize your terminals by project.",
	"license": "MIT",
	"author": "Connexio",
	"scripts": {
		"dev": "tauri dev",
		"dev:renderer": "vite",
		"build": "vite build",
		"build:renderer": "vite build",
		"build:tauri": "tauri build",
		"tauri": "tauri",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"format": "oxfmt --write .",
		"format:check": "oxfmt --check .",
		"lint": "oxlint src config",
		"test": "vitest run --config config/vitest.config.ts",
		"check:lines": "node config/check-max-lines.mjs",
		"check:boundaries": "node config/check-feature-imports.mjs",
		"prepare": "husky"
	},
	"dependencies": {
		"@codemirror/commands": "^6.10.3",
		"@codemirror/lang-css": "^6.3.1",
		"@codemirror/lang-html": "^6.4.11",
		"@codemirror/lang-javascript": "^6.2.5",
		"@codemirror/lang-json": "^6.0.2",
		"@codemirror/lang-markdown": "^6.5.0",
		"@codemirror/lang-python": "^6.2.1",
		"@codemirror/lang-rust": "^6.0.2",
		"@codemirror/language": "^6.12.3",
		"@codemirror/state": "^6.6.0",
		"@codemirror/view": "^6.42.1",
		"@tauri-apps/api": "^2.11.0",
		"@tauri-apps/plugin-dialog": "^2.7.1",
		"@tauri-apps/plugin-os": "^2.3.2",
		"@tauri-apps/plugin-process": "^2.3.1",
		"@tauri-apps/plugin-store": "^2.4.3",
		"@tauri-apps/plugin-updater": "^2.10.1",
		"@types/qrcode": "^1.5.6",
		"@xterm/addon-fit": "^0.10.0",
		"@xterm/addon-search": "^0.15.0",
		"@xterm/addon-web-links": "^0.11.0",
		"@xterm/addon-webgl": "^0.18.0",
		"@xterm/xterm": "^5.5.0",
		"highlight.js": "^11.10.0",
		"lucide-react": "^0.460.0",
		"qrcode": "^1.5.4",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"react-resizable-panels": "^4.11.1",
		"uuid": "^10.0.0",
		"zustand": "^4.5.5"
	},
	"devDependencies": {
		"@tauri-apps/cli": "^2.11.1",
		"@types/node": "^25.6.0",
		"@types/react": "^18.3.12",
		"@types/react-dom": "^18.3.1",
		"@types/uuid": "^10.0.0",
		"@vitejs/plugin-react": "^4.3.4",
		"autoprefixer": "^10.4.20",
		"husky": "^9.1.7",
		"lint-staged": "^17.3.0",
		"oxfmt": "^0.62.0",
		"oxlint": "^1.77.0",
		"postcss": "^8.4.49",
		"tailwindcss": "^3.4.15",
		"typescript": "^5.7.2",
		"vite": "^6.0.3",
		"vitest": "^4.1.10"
	},
	"lint-staged": {
		"*.{ts,tsx}": [
			"oxlint",
			"oxfmt --write"
		],
		"*.{json,css}": [
			"oxfmt --write"
		]
	}
}
